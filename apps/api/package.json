{
  "name": "@mpf/api",
  "private": true,
  "type": "module",
  "exports": {
    "./app": "./src/app.ts",
    "./db": "./src/db.ts",
    "./testing": "./test/helpers.ts"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --watch src/main.ts",
    "start": "node --env-file-if-exists=.env src/main.ts",
    "migrate": "node --env-file-if-exists=.env src/scripts/migrate.ts",
    "seed": "node --env-file-if-exists=.env src/scripts/seed.ts",
    "terminal:create": "node --env-file-if-exists=.env src/scripts/create-terminal.ts",
    "admin:create": "node --env-file-if-exists=.env src/scripts/create-admin.ts",
    "typecheck": "tsc -p .",
    "test": "vitest run"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.3",
    "@mpf/shared": "workspace:*",
    "hono": "^4.13.13",
    "postgres": "^3.4.9",
    "valibot": "^1.5.0"
  },
  "devDependencies": {
    "@types/node": "^24.19.1",
    "typescript": "^6.0.3",
    "vitest": "^5.0.3"
  }
}
