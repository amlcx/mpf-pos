{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Mi Postre Favorito",
  "version": "0.1.0",
  "identifier": "com.mpf.register",
  "build": {
    "beforeDevCommand": "pnpm dev:web",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build:web",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      { "title": "Mi Postre Favorito", "width": 1280, "height": 800, "minWidth": 1024, "minHeight": 640 }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  }
}
