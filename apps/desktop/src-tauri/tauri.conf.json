{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Mi Postre Favorito",
  "version": "0.1.0",
  "identifier": "com.mpf.register",
  "build": {
    "beforeDevCommand": "pnpm dev:web",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build:web",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      { "title": "Mi Postre Favorito", "width": 1280, "height": 800, "minWidth": 1024, "minHeight": 640 }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDdBNjg1QTdGNjZFRTlFRjAKUldUd251NW1mMXBvZW03TkJGSlFDc2QxTTFsVkNlQU0yRDNqOGIvcU5IVlVqeXdKQUVzUG1jVVUK",
      "windows": { "installMode": "passive" }
    }
  }
}
